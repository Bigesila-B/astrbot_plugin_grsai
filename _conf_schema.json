{
  "aspect_ratio": {
    "description": "默认图片比例",
    "type": "string",
    "hint": "用户未指定比例时使用此默认值。支持比例(如 1:1、16:9)或像素值(如 1024x1024)",
    "default": "1:1"
  },
  "models": {
    "description": "生图模型配置",
    "type": "template_list",
    "hint": "点击 + 添加模型配置。每个模型可设置独立的 API、触发词和参数",
    "default": [],
    "templates": {
      "model_item": {
        "name": "模型",
        "hint": "配置一个生图模型（API 地址、密钥、模型 ID、触发词等）",
        "items": {
          "trigger_t2i": {
            "description": "文生图触发词",
            "type": "string",
            "hint": "用户发送此词 + 提示词触发文生图，如：GPT生图",
            "default": "GPT生图"
          },
          "trigger_i2i": {
            "description": "图生图触发词",
            "type": "string",
            "hint": "用户发送此词 + 提示词 + 图片触发图生图，如：GPT改图",
            "default": "GPT改图"
          },
          "url": {
            "description": "API 基础 URL",
            "type": "string",
            "hint": "Grsai API 基础地址。全球: https://grsaiapi.com  国内: https://grsai.dakka.com.cn",
            "default": "https://grsaiapi.com"
          },
          "apikey": {
            "description": "API Key",
            "type": "string",
            "hint": "在 https://grsai.ai/zh/dashboard/api-keys 获取",
            "default": ""
          },
          "model_id": {
            "description": "模型 ID",
            "type": "string",
            "hint": "如 nano-banana-2、nano-banana-2-4k-cl、nano-banana-pro-vip",
            "default": "nano-banana-2"
          },
          "image_size": {
            "description": "输出分辨率",
            "type": "string",
            "hint": "1K(标准) / 2K(高清) / 4K(超清)。高端模型选 4K 需确保模型支持",
            "default": "1K",
            "options": ["1K", "2K", "4K"]
          },
          "pixel_size_mode": {
            "description": "比例转像素模式",
            "type": "bool",
            "hint": "开启后把 1:1、16:9 等比例自动转换成 1024x1024、1280x720 等像素值，适用于要求具体像素尺寸的新模型；关闭则保持原比例参数调用",
            "default": false
          },
          "reply_type": {
            "description": "回复类型",
            "type": "string",
            "hint": "json: 同步；async: 异步轮询(耗时较长时推荐)",
            "default": "json",
            "options": ["json", "async"]
          },
          "async_timeout": {
            "description": "异步任务超时(秒)",
            "type": "int",
            "hint": "当回复类型为 async 时最长等待时间",
            "default": 120
          },
          "retry_on_violation": {
            "description": "违规重试次数",
            "type": "int",
            "hint": "返回内容安全违规时自动重试次数。0 表示不重试",
            "default": 2
          }
        }
      }
    }
  },
  "presets": {
    "description": "自定义预设",
    "type": "template_list",
    "hint": "点击 + 添加新预设。预设通过 LLM 分析图片后自动生成改图提示词",
    "default": [],
    "templates": {
      "preset_item": {
        "name": "预设项",
        "hint": "配置一个自定义预设（触发词 + LLM + 提示词 + 生图模型）",
        "items": {
          "trigger": {
            "description": "触发词",
            "type": "string",
            "hint": "用户发送此词时触发该预设，如：动漫化",
            "default": ""
          },
          "model_trigger": {
            "description": "使用的生图模型",
            "type": "string",
            "hint": "填写生图模型的触发词（文生图或图生图触发词均可）来指定用哪个模型生成图片。留空则使用第一个模型",
            "default": ""
          },
          "llm_url": {
            "description": "LLM API 地址",
            "type": "string",
            "hint": "视觉语言模型 API 地址（OpenAI 兼容格式），如 https://api.openai.com/v1",
            "default": ""
          },
          "llm_apikey": {
            "description": "LLM API Key",
            "type": "string",
            "hint": "视觉语言模型的 API Key",
            "default": ""
          },
          "llm_model": {
            "description": "LLM 模型 ID",
            "type": "string",
            "hint": "需支持视觉识别，如 gpt-4o、qwen-vl-max",
            "default": "gpt-4o"
          },
          "preset_prompt": {
            "description": "预设提示词",
            "type": "text",
            "hint": "发给语言模型的指令，用于分析图片并生成改图提示词",
            "default": ""
          }
        }
      }
    }
  }
}
